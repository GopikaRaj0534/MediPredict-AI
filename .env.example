# MediPredict AI Environment Configuration Example
# Copy this file to .env and set your real configuration values.

SECRET_KEY=your_session_secret_key_here

# Replace YOUR_GEMINI_API_KEY_HERE with your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Optional: Google Places API Key for Nearby Hospital Finder
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
